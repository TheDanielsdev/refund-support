# --- LLM provider (free tiers work) ---
# one of: gemini | groq | mock   (mock = deterministic, no key needed)
LLM_PROVIDER=mock
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Database ---
POSTGRES_USER=refunds
POSTGRES_PASSWORD=refunds
POSTGRES_DB=refunds
DATABASE_URL=postgresql://refunds:refunds@db:5432/refunds?schema=public

# --- App ---
BACKEND_PORT=3001
FRONTEND_PORT=5173


# Milliseconds before an LLM call is abandoned (decision falls back to rules + template reply)
LLM_TIMEOUT_MS=10000
